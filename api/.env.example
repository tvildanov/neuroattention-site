# NeuroAttention API — environment variables (Railway / local)
# Copy to api/.env for local runs. Never commit real secrets.

# Core
DATABASE_URL=
JWT_SECRET=
PORT=3001
FRONTEND_URL=https://neuroattention.org
SUPERADMIN_EMAILS=domunity@icloud.com

# Monad — READ direction (Monad → site). Optional service token for GET-only.
MONAD_READONLY_TOKEN=

# Monad — WRITE/READ direction (site LK tab → Monad MCP). REQUIRED for «Монада» tab.
# Value: Monad API key (same family as in AGENTS.md). Never expose to the browser.
MONAD_API_KEY=
# LLM face is NOT on this API. Persona talks on monad-server (persona_runtime).
# Do not add ANTHROPIC/OPENAI/OPENROUTER here to “make LK speak”.
# Optional leftover keys are unused by POST /api/monad/message.
# Optional overrides:
# MONAD_MCP_URL=https://monad-server-production.up.railway.app/mcp
# MONAD_DASHBOARD_URL=https://monad-server-production.up.railway.app/dashboard

# SMTP / Stripe / wearables — see CLAUDE.md and existing Railway vars
